# ============================================================
# 生产环境变量配置
# 用法：复制为 /www/wwwroot/plant-cultivation/.env 并填写真实值
# 注意：此文件不要提交到 git（.gitignore 已忽略 *.env）
# ============================================================

# MySQL 数据库密码
DB_PASSWORD=你的数据库密码

# JWT 签名密钥（生成方式：openssl rand -base64 48）
JWT_SECRET=你的JWT密钥

# 图片上传目录（宝塔默认可不改）
UPLOAD_DIR=/www/wwwroot/uploads
